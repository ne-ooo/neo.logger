{
  "name": "@lpm.dev/neo.logger",
  "version": "1.0.0",
  "description": "Zero-dependency production logger - Fast, modern alternative to winston and pino",
  "author": "neo",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    ".lpm",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node scripts/copy-cjs-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "type-check": "tsc --noEmit",
    "test:types": "tsc -p type-smoke/tsconfig.json",
    "test:package": "node test/release/cjs-smoke.cjs && node test/release/esm-smoke.mjs && lpm run test:types",
    "release:check": "lpm run type-check && lpm run build && lpm run test && lpm run test:package",
    "prepublishOnly": "lpm run release:check"
  },
  "keywords": [
    "logger",
    "logging",
    "winston",
    "pino",
    "bunyan",
    "zero-dependency",
    "typescript",
    "structured-logging",
    "json-logger",
    "console-logger",
    "esm",
    "tree-shakeable"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.logger"
  },
  "homepage": "https://github.com/ne-ooo/neo.logger#readme",
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.logger/issues"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "lpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "vite": "^6.4.3"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
